<Application x:Class="PosCore.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PosCore">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/ButtonStyles.xaml" />
                <ResourceDictionary Source="Themes/TextBoxStyles.xaml" />
                <ResourceDictionary Source="Themes/CardStyles.xaml" />
                <ResourceDictionary Source="Themes/GridStyles.xaml" />
                <ResourceDictionary Source="Themes/Animations.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <FontFamily x:Key="PrimaryFont">pack://application:,,,/Fonts/#Poppins, pack://application:,,,/Fonts/#Roboto, Segoe UI, sans-serif</FontFamily>
            <FontFamily x:Key="MonoFont">pack://application:,,,/Fonts/#IBM Plex Mono, Consolas, monospace</FontFamily>
            
            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="{StaticResource PrimaryFont}" />
            </Style>
            <!-- Backward compatibility for existing keys -->
            <SolidColorBrush x:Key="ThemePrimaryColor" Color="{StaticResource PrimaryColor}" />
            <SolidColorBrush x:Key="ThemeSecondaryColor" Color="{StaticResource SecondaryColor}" />
            <SolidColorBrush x:Key="ThemeBackgroundColor" Color="{StaticResource BackgroundColor}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
