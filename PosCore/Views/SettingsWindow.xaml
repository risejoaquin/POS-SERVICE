<Window x:Class="PosCore.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración de Atajos" Height="450" Width="600" WindowStartupLocation="CenterOwner"
        Background="#F9FAFB">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Perfil de Industria:" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="CmbIndustry" Width="180" FontSize="14" SelectionChanged="CmbIndustry_SelectionChanged" Padding="5">
                <ComboBoxItem Content="Abarrotes" IsSelected="True" />
                <ComboBoxItem Content="Restaurante" />
                <ComboBoxItem Content="Farmacia" />
            </ComboBox>
        </StackPanel>
        
        <DataGrid x:Name="GridShortcuts" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" Background="White" RowHeight="35" FontSize="14" BorderBrush="#E5E7EB">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="130" />
                <DataGridTextColumn Header="Ícono" Binding="{Binding Icon}" Width="60" />
                <DataGridTextColumn Header="Color (Hex)" Binding="{Binding Color}" Width="90" />
                <DataGridTextColumn Header="Acción" Binding="{Binding Action}" Width="120" />
                <DataGridTextColumn Header="Descripción" Binding="{Binding Description}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>
        
        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Cancelar" Width="90" Height="35" Margin="0,0,10,0" FontSize="14" Click="BtnCancel_Click" Background="White" BorderBrush="#D1D5DB" BorderThickness="1"/>
            <Button Content="Guardar" Width="90" Height="35" Background="#2D5F2E" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
