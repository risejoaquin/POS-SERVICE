<Window x:Class="PosCore.Views.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PosCore.Views"
        mc:Ignorable="d"
        Title="Reportes y Análisis" Height="700" Width="900" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <TextBlock Text="Reportes y Cierre de Caja" FontSize="28" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>
        
        <!-- Summary Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Border Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Ventas de Hoy" FontSize="16" Foreground="#6C757D"/>
                    <TextBlock Text="{Binding TodayTotalRevenue, StringFormat={}{0:C}}" FontSize="28" FontWeight="Bold" Foreground="#28A745" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            
            <Border Grid.Column="1" Background="#F8F9FA" BorderBrush="#E9ECEF" BorderThickness="1" CornerRadius="8" Padding="20" Margin="10,0,10,0">
                <StackPanel>
                    <TextBlock Text="Órdenes de Hoy" FontSize="16" Foreground="#6C757D"/>
                    <TextBlock Text="{Binding TodayTotalOrders}" FontSize="28" FontWeight="Bold" Foreground="#007BFF" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <Button Grid.Column="2" Content="Imprimir Cierre (PDF)" Command="{Binding ExportEndOfDayPdfCommand}" Width="160" Background="#DC3545" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Margin="10,0,0,0"/>
        </Grid>
        
        <!-- Details -->
        <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0">
            <TabItem Header="Ventas por Día" FontSize="16">
                <DataGrid ItemsSource="{Binding DailySales}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0"
                          Background="White" RowHeight="40" AlternatingRowBackground="#F9F9F9" GridLinesVisibility="None" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Fecha" Binding="{Binding Date, StringFormat=dd/MM/yyyy}" Width="*"/>
                        <DataGridTextColumn Header="Órdenes" Binding="{Binding TotalOrders}" Width="*"/>
                        <DataGridTextColumn Header="Ingresos Totales" Binding="{Binding TotalRevenue, StringFormat={}{0:C}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            
            <TabItem Header="Productos Más Vendidos" FontSize="16">
                <DataGrid ItemsSource="{Binding TopProducts}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0"
                          Background="White" RowHeight="40" AlternatingRowBackground="#F9F9F9" GridLinesVisibility="None" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Producto" Binding="{Binding ProductName}" Width="2*"/>
                        <DataGridTextColumn Header="Cantidad Vendida" Binding="{Binding QuantitySold}" Width="*"/>
                        <DataGridTextColumn Header="Ingresos Generados" Binding="{Binding TotalRevenue, StringFormat={}{0:C}}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            
            <TabItem Header="Alerta: Bajo Stock" FontSize="16">
                <DataGrid ItemsSource="{Binding LowStockProducts}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,10,0,0"
                          Background="White" RowHeight="40" AlternatingRowBackground="#FFF3CD" GridLinesVisibility="None" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Barcode}" Width="*"/>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Stock Actual" Binding="{Binding StockQuantity}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
