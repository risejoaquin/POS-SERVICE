<Window x:Class="PosCore.Views.InventoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PosCore.Views"
        mc:Ignorable="d"
        Title="Control de Inventario" Height="500" Width="800" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Inventario de Productos" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
        
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista de Productos -->
            <Grid Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Agregar Nuevo" Command="{Binding AddProductCommand}" Width="120" Height="35" Background="#28A745" Foreground="White" BorderThickness="0" Margin="0,0,10,0"/>
                    <Button Content="Editar" Command="{Binding EditProductCommand}" Width="100" Height="35" Background="#007BFF" Foreground="White" BorderThickness="0" Margin="0,0,10,0"  />
                    <Button Content="Eliminar" Command="{Binding DeleteProductCommand}" Width="100" Height="35" Background="#DC3545" Foreground="White" BorderThickness="0" />
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Barcode}" Width="100"/>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Precio" Binding="{Binding Price, StringFormat=C}" Width="100"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Formulario de Edición (Visible solo cuando IsEditing es True) -->
            <Border Grid.Column="1" Background="#F8F9FA" Padding="15" CornerRadius="5" Visibility="{Binding IsEditing, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Detalles del Producto" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Código de Barras:" Margin="0,0,0,5" FontWeight="Medium"/>
                    <TextBox Text="{Binding EditingProduct.Barcode, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,15" Padding="5,0"/>

                    <TextBlock Text="Nombre:" Margin="0,0,0,5" FontWeight="Medium"/>
                    <TextBox Text="{Binding EditingProduct.Name, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,15" Padding="5,0"/>

                    <TextBlock Text="Precio:" Margin="0,0,0,5" FontWeight="Medium"/>
                    <TextBox Text="{Binding EditingProduct.Price, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,15" Padding="5,0"/>

                    <TextBlock Text="Stock:" Margin="0,0,0,5" FontWeight="Medium"/>
                    <TextBox Text="{Binding EditingProduct.StockQuantity, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,0,0,20" Padding="5,0"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Command="{Binding CancelEditCommand}" Width="90" Height="35" Background="#6C757D" Foreground="White" BorderThickness="0" Margin="0,0,10,0"/>
                        <Button Content="Guardar" Command="{Binding SaveProductCommand}" Width="90" Height="35" Background="#28A745" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
