<Window x:Class="PosCore.Views.PaymentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cobrar Venta" Height="650" Width="800"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Background="White" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Column: Details -->
        <StackPanel Grid.Column="0" Margin="0,0,20,0">
            <TextBlock Text="Total a Cobrar" FontSize="18" Foreground="Gray" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TotalText" Text="$0.00" FontSize="56" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <TextBlock Text="Efectivo Recibido" FontSize="18" Foreground="Gray" HorizontalAlignment="Center"/>
            <TextBlock x:Name="TenderedText" Text="$0.00" FontSize="48" FontWeight="Bold" Foreground="#3B82F6" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            
            <TextBlock x:Name="ChangeText" Text="Cambio: $0.00" FontSize="24" FontWeight="SemiBold" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,30" Visibility="Hidden"/>
            
            <!-- Lealtad -->
            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="15">
                <StackPanel>
                    <TextBlock Text="Programa de Lealtad" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CustomerPhoneBox" FontSize="16" Padding="5" Text="Teléfono del cliente..."/>
                        <Button Grid.Column="1" Content="Buscar" Width="80" Margin="10,0,0,0" Background="#3B82F6" Foreground="White" BorderThickness="0" Click="BtnSearchCustomer_Click"/>
                    </Grid>
                    
                    <StackPanel x:Name="CustomerInfoPanel" Visibility="Collapsed" Margin="0,15,0,0">
                        <TextBlock x:Name="CustomerNameText" Text="Cliente: Juan Pérez" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CustomerPointsText" Text="Puntos disponibles: 150 pts ($15.00)" Foreground="#F59E0B" FontWeight="Bold" Margin="0,5,0,10"/>
                        <CheckBox x:Name="UsePointsCheck" Content="Pagar con Puntos / Monedero" FontSize="14"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Right Column: Numpad & Actions -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Touch Numpad -->
            <Grid x:Name="NumpadGrid" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid.Resources>
                    <Style TargetType="Button">
                        <Setter Property="FontSize" Value="28"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Background" Value="#F3F4F6"/>
                        <Setter Property="Foreground" Value="#111827"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="Margin" Value="2"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                </Grid.Resources>

                <Button Content="7" Grid.Row="0" Grid.Column="0" Click="BtnNum_Click"/>
                <Button Content="8" Grid.Row="0" Grid.Column="1" Click="BtnNum_Click"/>
                <Button Content="9" Grid.Row="0" Grid.Column="2" Click="BtnNum_Click"/>
                
                <Button Content="4" Grid.Row="1" Grid.Column="0" Click="BtnNum_Click"/>
                <Button Content="5" Grid.Row="1" Grid.Column="1" Click="BtnNum_Click"/>
                <Button Content="6" Grid.Row="1" Grid.Column="2" Click="BtnNum_Click"/>
                
                <Button Content="1" Grid.Row="2" Grid.Column="0" Click="BtnNum_Click"/>
                <Button Content="2" Grid.Row="2" Grid.Column="1" Click="BtnNum_Click"/>
                <Button Content="3" Grid.Row="2" Grid.Column="2" Click="BtnNum_Click"/>
                
                <Button Content="0" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Click="BtnNum_Click"/>
                <Button Content="Borrar" Grid.Row="3" Grid.Column="2" FontSize="16" Background="#EF4444" Foreground="White" Click="BtnClear_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Orientation="Vertical">
                <Button Content="Exacto (Tarjeta/Efectivo)" Height="45" Margin="0,0,0,10" Background="#3B82F6" Foreground="White" FontWeight="Bold" FontSize="16" BorderThickness="0" Click="BtnExact_Click"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Content="Cancelar" Grid.Column="0" Height="50" Margin="0,0,5,0" Background="#E5E7EB" BorderThickness="0" Click="BtnCancel_Click"/>
                    <Button Content="Cobrar" Grid.Column="1" Height="50" Margin="5,0,0,0" Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="18" BorderThickness="0" Click="BtnPay_Click" IsDefault="True"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
