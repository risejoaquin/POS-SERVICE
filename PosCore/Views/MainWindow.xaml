<Window x:Class="PosCore.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PosCore.Views"
        xmlns:vm="clr-namespace:PosCore.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Settings.WhiteLabel.CompanyName, StringFormat='{}POS - {0} (Modo Offline)'}" Height="600" Width="900" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Área de Productos -->
        <GroupBox Header="Catálogo de Productos" Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" FontSize="14">
            <ListView ItemsSource="{Binding Products}" BorderThickness="0" Margin="5">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10" Width="250">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Price, StringFormat=C}" Foreground="#007ACC" FontWeight="Bold" FontSize="14" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Barcode, StringFormat=Cod: {0}}" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Añadir" 
                                        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Width="70" Height="35" Margin="10,0,0,0" 
                                        Background="{Binding DataContext.PrimaryColorBrush, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <!-- Usar un WrapPanel para que los productos fluyan horizontalmente -->
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>
        </GroupBox>

        <!-- Área de Carrito y Cobro -->
        <GroupBox Header="Carrito de Compras" Grid.Row="0" Grid.Column="1" FontSize="14">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListView ItemsSource="{Binding Cart}" Grid.Row="0" BorderThickness="0" Margin="0,0,0,10">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Product.Name}" Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Quantity, StringFormat={}{0}x}" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding SubTotal, StringFormat=C}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Totales -->
                <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="0,10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Total:" FontSize="20" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Total, StringFormat=C}" FontSize="24" FontWeight="Bold" Foreground="#28A745" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Botón de Cobro -->
                <Button Grid.Row="2" Content="Completar Venta" 
                        Command="{Binding CheckoutCommand}" 
                        Height="50" FontSize="18" Background="{Binding PrimaryColorBrush}" Foreground="White" FontWeight="Bold" 
                        BorderThickness="0" Cursor="Hand" Margin="0,10,0,0"/>
            </Grid>
        </GroupBox>

        <!-- Módulos Opcionales -->
        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Gestión de Mesas" Width="150" Height="40" Margin="0,0,10,0" 
                    Background="#6C757D" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Visibility="{Binding Settings.Modules.EnableTableManagement, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            
            <Button Content="Reportes y Cierre" Width="150" Height="40" Margin="0,0,10,0" Background="#6C757D" Foreground="White" BorderThickness="0" Cursor="Hand" Command="{Binding OpenReportsCommand}" />
            <Button Content="Control de Inventario" Width="150" Height="40" Margin="0,0,10,0" 
                    Background="#6C757D" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Command="{Binding OpenInventoryCommand}"
                    Visibility="{Binding Settings.Modules.EnableInventoryControl, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</Window>
