<Window x:Class="PosCore.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PosCore.Views"
        xmlns:vm="clr-namespace:PosCore.ViewModels"
        mc:Ignorable="d"
        Title="{Binding Settings.WhiteLabel.CompanyName, StringFormat='{}POS - {0}'}" Height="600" Width="900" WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F12" Command="{Binding CheckoutCommand}" />
        <KeyBinding Key="F4" Command="{Binding OpenShiftCommand}" />
    </Window.InputBindings>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Top Header for Network & Sync Status -->
        <Border Background="{Binding PrimaryColorBrush}" CornerRadius="4" Padding="10,5" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Settings.WhiteLabel.CompanyName, StringFormat='{}☕ {0}'}" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{Binding SyncStatusColor}" Margin="0,0,5,0" />
                    <TextBlock Text="{Binding SyncStatusMessage}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

        <!-- Área de Productos -->
        <GroupBox Header="Catálogo de Productos" Grid.Row="0" Grid.Column="0" Margin="0,0,10,10" FontSize="14">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="5,0,10,0" FontSize="18"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" 
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="18" Padding="5" 
                             ToolTip="Buscar producto por nombre o escanear código de barras"/>
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{Binding FilteredProducts}" BorderThickness="0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10" Width="250">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Price, StringFormat=C}" Foreground="#007ACC" FontWeight="Bold" FontSize="14" Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Barcode, StringFormat='Cod: {0}'}" FontSize="11" Foreground="Gray"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Añadir" 
                                        Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Width="70" Height="35" Margin="10,0,0,0" 
                                        Background="{Binding DataContext.PrimaryColorBrush, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
                <!-- Usar un WrapPanel para que los productos fluyan horizontalmente -->
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                </ListView>
            </Grid>
        </GroupBox>

        <!-- Área de Carrito y Cobro -->
        <GroupBox Header="Carrito de Compras" Grid.Row="0" Grid.Column="1" FontSize="14">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListView ItemsSource="{Binding Cart}" Grid.Row="0" BorderThickness="0" Margin="0,0,0,10">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Product.Name}" Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,5,0"/>
                                
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="-" Width="22" Height="22" 
                                            Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                            CommandParameter="{Binding}" 
                                            Background="#E5E7EB" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Quantity}" Width="26" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <Button Content="+" Width="22" Height="22" 
                                            Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                            CommandParameter="{Binding}" 
                                            Background="#E5E7EB" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                                </StackPanel>

                                <TextBlock Text="{Binding SubTotal, StringFormat=C}" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" Margin="0,0,10,10"/>
                                
                                <Button Grid.Column="3" Content="✕" Width="26" Height="26" 
                                        Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding}" 
                                        Background="#EF4444" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Totales y Descuentos -->
                <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="0,10">
                    <StackPanel HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5">
                            <TextBlock Text="Subtotal:" FontSize="16" Foreground="Gray" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding SubTotal, StringFormat=C}" FontSize="16" Foreground="Gray"/>
                        </StackPanel>
                        
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5" Visibility="{Binding IsDiscountApplied, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- Si DiscountAmount > 0 se muestra -->
                            <TextBlock Text="Promoción Aplicada:" FontSize="14" Foreground="#F59E0B" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding DiscountAmount, StringFormat='-{0:C}'}" FontSize="14" Foreground="#F59E0B" FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                            <TextBlock Text="Total:" FontSize="20" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Total, StringFormat=C}" FontSize="24" FontWeight="Bold" Foreground="#28A745" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Acciones de Orden -->
                <Grid Grid.Row="2" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="⏸ Suspender" Command="{Binding SuspendOrderCommand}" Margin="0,0,5,0" Height="40" Background="#F59E0B" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                        <Button Grid.Column="1" Content="▶ Retomar Orden" Command="{Binding ResumeOrderCommand}" Margin="5,0,0,0" Height="40" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    </Grid>

                    <!-- Botón de Cobro -->
                    <Button Grid.Row="1" Content="Completar Venta (F12)" 
                        Command="{Binding CheckoutCommand}" 
                        Height="50" FontSize="18" Background="{Binding PrimaryColorBrush}" Foreground="White" FontWeight="Bold" 
                        BorderThickness="0" Cursor="Hand" Margin="0,10,0,0"/>
            </Grid>
        </GroupBox>

    </Grid>
        <!-- Módulos Opcionales -->
        <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Gestión de Mesas" Width="150" Height="40" Margin="0,0,10,10" 
                    Background="#6C757D" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Visibility="{Binding Settings.Modules.EnableTableManagement, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            
                        <Button Content="Probar Impresora" Width="130" Height="40" Margin="0,0,10,10" Background="#10B981" Foreground="White" BorderThickness="0" Cursor="Hand" Command="{Binding TestPrinterCommand}" />
            <Button Content="Logs" Width="100" Height="40" Margin="0,0,10,10" Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand" Command="{Binding OpenLogsCommand}" />
            <Button Content="Arqueo / Turno (F4)" Width="130" Height="40" Margin="0,0,10,10" Background="#8B5CF6" Foreground="White" BorderThickness="0" Cursor="Hand" Command="{Binding OpenShiftCommand}" />
            <Button Content="Devoluciones" Width="120" Height="40" Margin="0,0,10,10" Background="#F59E0B" Foreground="White" BorderThickness="0" Cursor="Hand" Command="{Binding OpenReturnsCommand}" />
            <Button Content="Reportes y Cierre" Width="150" Height="40" Margin="0,0,10,10" Background="#6C757D" Foreground="White" BorderThickness="0" Cursor="Hand" Command="{Binding OpenReportsCommand}" />
            <Button Content="Control de Inventario" Width="150" Height="40" Margin="0,0,10,10" 
                    Background="#6C757D" Foreground="White" BorderThickness="0" Cursor="Hand"
                    Command="{Binding OpenInventoryCommand}"
                    Visibility="{Binding Settings.Modules.EnableInventoryControl, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </WrapPanel>

        <!-- Toast Notification Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Grid.ColumnSpan="2" 
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,20" Padding="20,15" CornerRadius="8"
                Background="{Binding NotificationColor}"
                Visibility="{Binding IsNotificationVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                Panel.ZIndex="999">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" ShadowDepth="4" BlurRadius="8"/>
            </Border.Effect>
            <TextBlock Text="{Binding NotificationMessage}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
