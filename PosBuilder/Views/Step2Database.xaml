<UserControl x:Class="PosBuilder.Views.Step2Database"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20">
        <TextBlock Text="Paso 2: Base de Datos" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
        
        <TextBlock Text="Tipo de Base de Datos" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <ComboBox SelectedValue="{Binding DbType, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Margin="0,0,0,15" Padding="5">
            <ComboBoxItem Content="SQLite"/>
            <ComboBoxItem Content="PostgreSQL"/>
        </ComboBox>
        
        <StackPanel Visibility="{Binding DbType, Converter={StaticResource DbTypeToVisibilityConverter}}">
            <TextBlock Text="Host" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox ToolTip="Dirección del servidor de base de datos." Text="{Binding DbHost, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,15" />
            
            <TextBlock Text="Puerto" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox ToolTip="El puerto debe estar entre 1000-65535. Default PG: 5432." Text="{Binding DbPort, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,15" />
            
            <TextBlock Text="Usuario" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox ToolTip="Usuario administrador de la base de datos." Text="{Binding DbUser, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,15" />
            
            <TextBlock Text="Contraseña" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox ToolTip="Contraseña de la base de datos." Text="{Binding DbPassword, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,15" />
            
            <TextBlock Text="Nombre DB" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox ToolTip="Nombre de la base de datos a crear o usar." Text="{Binding DbName, UpdateSourceTrigger=PropertyChanged}" Padding="8" Margin="0,0,0,15" />
            
            <Button Content="{Binding TestDbButtonText, FallbackValue='Test Connection'}" Command="{Binding TestConnectionCommand}" Padding="10" Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand"/>

        </StackPanel>
    </StackPanel>
</UserControl>