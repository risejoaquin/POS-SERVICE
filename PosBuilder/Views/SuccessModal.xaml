<Window x:Class="PosBuilder.Views.SuccessModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generación Completada" Height="400" Width="550"
        WindowStartupLocation="CenterOwner" Background="White"
        FontFamily="Segoe UI" WindowStyle="ToolWindow">
    
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="🎉 Configuración Validada" FontSize="24" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,10"/>
            <TextBlock Text="Los archivos han sido generados y verificados con integridad SHA-256." FontSize="14" Foreground="#475569" Margin="0,0,0,20"/>
            
            <Border Background="#F1F5F9" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Ubicación de instalador:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="LocationText" Text="C:\Output\Setup.exe" Foreground="#3B82F6" TextWrapping="Wrap" Margin="0,0,0,15"/>
                    
                    <TextBlock Text="Credenciales Iniciales:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBlock x:Name="CredentialsText" Text="Admin: admin / 1234" TextWrapping="Wrap" FontFamily="Consolas"/>
                </StackPanel>
            </Border>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Copiar Credenciales" Click="CopyCredentials_Click" Padding="15,10" Background="#F1F5F9" Foreground="#334155" BorderThickness="1" BorderBrush="#CBD5E1" Margin="0,0,10,0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="Abrir Carpeta de Instaladores" Click="OpenFolder_Click" Padding="15,10" Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
