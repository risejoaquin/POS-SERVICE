<UserControl x:Class="PosBuilder.Views.Step6Modules"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20">
        <TextBlock Text="Paso 6: Módulos" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
        
        <UniformGrid Columns="2" Margin="0,0,0,15">
            <CheckBox Content="Inventario" ToolTip="Activa el manejo de entradas, salidas y existencias de productos." IsChecked="{Binding ModuleInventory}" Margin="5" FontSize="16"/>
            <CheckBox Content="Reportes" ToolTip="Habilita el panel de métricas, gráficas y exportación." IsChecked="{Binding ModuleReports}" Margin="5" FontSize="16"/>
            <CheckBox Content="Crédito/Vales" ToolTip="Permite fiar o vender a crédito a clientes registrados." IsChecked="{Binding ModuleCredit}" Margin="5" FontSize="16"/>
            <CheckBox Content="Multi-Sucursal" ToolTip="Permite gestionar múltiples sucursales centralizadas." IsChecked="{Binding ModuleMultiStore}" Margin="5" FontSize="16"/>
        </UniformGrid>
    </StackPanel>
</UserControl>