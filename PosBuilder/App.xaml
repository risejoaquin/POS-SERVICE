<Application x:Class="PosBuilder.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PosBuilder"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <local:StringToBoolConverter x:Key="StringToBoolConverter" />
        <local:DbTypeToVisibilityConverter x:Key="DbTypeToVisibilityConverter" />
        <local:InverseBooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Application.Resources>
</Application>
